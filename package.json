{
  "name": "vnetgrowth-telegram-session-loader",
  "version": "0.1.6",
  "private": true,
  "description": "Import HStock-style Telegram session bundles and open an isolated portable Telegram Desktop.",
  "main": "./out/main/index.js",
  "author": "tuel-technology",
  "productName": "Telegram Session Loader",
  "build": {
    "appId": "com.virtualnetgrowth.telegram-session-loader",
    "productName": "Telegram Session Loader",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "artifactName": "VNG-Telegram-Session-Loader-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "icon.png",
          "logo.svg"
        ]
      },
      {
        "from": "python-sidecar",
        "to": "python-sidecar",
        "filter": [
          "**/*",
          "!.venv/**"
        ]
      },
      {
        "from": ".venv",
        "to": "sidecar-venv",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.utilities",
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "tuel-technology"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tuel-technology",
        "repo": "vnetgrowth-telegram-session-loader",
        "releaseType": "release"
      }
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.js --publish never",
    "dist:mac": "electron-vite build && electron-builder --config electron-builder.config.js --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --config electron-builder.config.js --win --publish never",
    "sidecar:install": "python3 -m venv .venv && .venv/bin/pip install -r python-sidecar/requirements.txt",
    "sidecar:install:win": "python -m venv .venv && .venv\\Scripts\\pip install -r python-sidecar/requirements.txt"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.9",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20.17.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
